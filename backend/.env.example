# Copy to .env and fill in real values. Never commit .env.

# Must include the database name (/stockyard) — without it Mongoose silently uses "test".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/stockyard?retryWrites=true&w=majority
PORT=5000
JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))">

# Exact frontend origin(s), comma-separated. No trailing slash.
CORS_ORIGIN=https://your-frontend-domain.com
NODE_ENV=production

# Only used the first time the app starts against an empty database, to create
# the initial admin account. Required in production; the seed is skipped without it.
SEED_ADMIN_PASSWORD=
